# ---------------------------------------------------------------------------
# Database — PostgreSQL (Supabase, Neon, RDS or local)
#
# SUPABASE: Dashboard -> Connect -> "Connection string".
#   Three endpoints are offered; they are NOT interchangeable:
#
#   • Session pooler   port 5432  aws-0-<region>.pooler.supabase.com
#       Use for migrations and seeding (npm run db:deploy / db:seed),
#       and for local development. IPv4 compatible.
#
#   • Transaction pooler  port 6543  aws-0-<region>.pooler.supabase.com
#       Use for the deployed app on Vercel. Append ?pgbouncer=true —
#       PgBouncer runs in transaction mode and rejects prepared statements.
#       Migrations will NOT work through this port.
#
#   • Direct  port 5432  db.<ref>.supabase.co
#       IPv6-only on the free plan; usually unreachable from home networks.
#
# Local development / migrations (session pooler):
DATABASE_URL="postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Vercel runtime value (transaction pooler) — set this in the Vercel dashboard:
# DATABASE_URL="postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ---------------------------------------------------------------------------
# Authentication — Auth.js v5
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Public site URL — used for canonical links, sitemap and OpenGraph
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Cloudinary — optional. Without it the media library accepts URLs only.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Seed account — read by `npm run db:seed` only
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@j2securetech.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="System Administrator"
