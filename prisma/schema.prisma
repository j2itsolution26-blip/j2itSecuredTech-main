// J2 SecureTech — Enterprise Data Model
// PostgreSQL (Neon) + Prisma ORM

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum ServiceCategory {
  SOFTWARE
  WEBSITE
  IOT
  NETWORK
  CYBERSECURITY
  SECURITY
  TELEPHONY
  ELECTRONICS
  CLOUD
  CONSULTING
  SUPPORT
  TRAINING
}

enum QuoteStatus {
  PENDING
  REVIEWING
  QUOTED
  WON
  LOST
  ARCHIVED
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String
  role          UserRole  @default(EDITOR)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  blogPosts BlogPost[]
  auditLogs AuditLog[]

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Marketing Content
// ---------------------------------------------------------------------------

model Service {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  category    ServiceCategory
  summary     String
  description String
  icon        String          @default("Cpu")
  features    String[]        @default([])
  deliverables String[]       @default([])
  image       String?
  metaTitle   String?
  metaDesc    String?
  order       Int             @default(0)
  isActive    Boolean         @default(true)
  isFeatured  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, isActive])
  @@index([order])
  @@map("services")
}

model Portfolio {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  category     String
  client       String
  industry     String?
  location     String?
  summary      String
  overview     String
  challenge    String?
  solution     String?
  technologies String[]  @default([])
  features     String[]  @default([])
  results      String[]  @default([])
  images       String[]  @default([])
  thumbnail    String
  metaTitle    String?
  metaDesc     String?
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category, isActive])
  @@index([isFeatured, isActive])
  @@map("portfolio_projects")
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  featuredImage String?
  category      String
  tags          String[]  @default([])
  readingTime   Int       @default(5)
  views         Int       @default(0)
  isPublished   Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  publishedAt   DateTime?
  metaTitle     String?
  metaDesc      String?
  authorId      String?
  authorName    String    @default("J2 SecureTech Editorial")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@index([category])
  @@map("blog_posts")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  industry  String?
  content   String
  image     String?
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  isFeatured Boolean @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@map("testimonials")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@map("faqs")
}

model Career {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  department     String
  type           EmploymentType @default(FULL_TIME)
  location       String
  isRemote       Boolean        @default(false)
  salaryRange    String?
  description    String
  responsibilities String[]     @default([])
  requirements   String[]       @default([])
  benefits       String[]       @default([])
  isActive       Boolean        @default(true)
  closesAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([isActive, department])
  @@map("careers")
}

model Industry {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String   @default("Building2")
  challenges  String[] @default([])
  solutions   String[] @default([])
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("industries")
}

// ---------------------------------------------------------------------------
// Lead Capture
// ---------------------------------------------------------------------------

model QuoteRequest {
  id          String      @id @default(cuid())
  reference   String      @unique
  name        String
  company     String?
  email       String
  phone       String
  service     String
  budget      String?
  timeline    String?
  description String
  status      QuoteStatus @default(PENDING)
  notes       String?
  ipAddress   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("quote_requests")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String
  status    MessageStatus @default(UNREAD)
  notes     String?
  ipAddress String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Media {
  id        String    @id @default(cuid())
  name      String
  url       String
  publicId  String?   @unique
  type      MediaType @default(IMAGE)
  format    String?
  width     Int?
  height    Int?
  bytes     Int       @default(0)
  folder    String    @default("j2securetech")
  alt       String?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@map("media")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  label     String
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String
  entityId  String?
  summary   String
  metadata  Json?
  userId    String?
  userEmail String?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
